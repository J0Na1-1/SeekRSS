{
  "name": "seekrss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Single-operator RSS monitoring with shared Web and Telegram configuration",
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun && bun build scripts/admin-reset.ts --outdir dist --target bun",
    "start": "bun run dist/server.js",
    "test": "bun test tests/",
    "typecheck": "tsc -p tsconfig.seekrss.json --noEmit",
    "backup": "bun run scripts/backup.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "bcryptjs": "2.4.3",
    "zod": "4.6.7",
    "fast-xml-parser": "5.11.2",
    "undici": "7.30.1",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "@playwright/test": "1.58.2"
  }
}

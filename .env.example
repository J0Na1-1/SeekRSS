# SeekRSS: copy to .env only if overriding infrastructure defaults.
HOST=0.0.0.0
PORT=3010
DATABASE_PATH=./data/seekrss.db
# Docker defaults to loopback. Publish through an HTTPS reverse proxy or SSH tunnel.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3010
# Optional strong bootstrap key; otherwise generated in the data volume as setup.key.
# SETUP_KEY=
# Optional persistent encryption passphrase. If omitted, secret.key is generated in data/.
# Keep this value or secret.key with backups; changing it makes saved tokens unreadable.
# SECRET_KEY=
# Enable only behind HTTPS (required for safe public Internet access).
COOKIE_SECURE=false
# Exact external origin when an HTTPS proxy forwards to this HTTP backend.
# PUBLIC_ORIGIN=https://rss.example.com
# RSS sources, polling budgets, Telegram Token and admin ID are managed in Web / Bot.
